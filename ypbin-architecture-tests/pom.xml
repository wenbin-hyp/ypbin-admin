<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin.admin</groupId>
        <artifactId>ypbin-admin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ypbin-architecture-tests</artifactId>
    <name>${project.artifactId}</name>
    <description>架构约束测试：把 admin 铁律变为构建失败（禁内联全限定类名/禁 Collections.emptyXxx/禁 @Data/禁 Enum.ordinal/禁循环内 DB-RPC/实体继承例外清单显式）</description>

    <properties>
        <!-- 纯测试模块：不发布、不打进任何服务的产物，也不该出现在别人的依赖树里 -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <!-- 与 ypbin-starter-architecture-tests 同版本（starter 侧由 ypbin-starter-dependencies 管理，
             本仓不复用 starter 的 dependencies pom，故在此显式钉住，避免两仓规则库行为分叉） -->
        <archunit.version>1.5.0</archunit.version>
    </properties>

    <dependencies>
        <!--
          分析对象：admin 各模块的主源码与字节码，故以 test 作用域聚合（不污染任何其它模块）。
          ⛔ 这 7 个依赖**不是**可有可无的——它们正是本门禁的分析目标：CodingRulesTest#importClasses 用
          `importPackages("cn.ypbin.admin")` 从测试类路径导入全仓真实字节码。删掉任何一个，该模块的类就
          静默退出分析范围（三条无 `that()` 子句的字节码规则会退化成空转=恒真；带 `that()` 子句的
          service/impl→provider 规则则会报 "failed to check any classes"）。因此「跨模块依赖脆弱」这件事
          不能靠删依赖解决，已改为让合成夹具自包含（见 src/test/java/cn/ypbin/admin/arch/synthetic/**，
          编译期不再引用任何跨模块真实类），并由
          ArchRuleSelfCheckTest#syntheticFixturesMustBeSelfContained 防回归。
          本清单 = 全仓含 src/main/java 的模块全集（ypbin-common / *-api / ypbin-service 下两域 / auth / gateway，
          实测共 392 个 class，其中 service/impl 48 个、provider 13 个正是新规则的作用对象）；
          新增业务模块时必须同步补一行，否则新域的规则覆盖会静默缺失。
          ⚠️ 已知残留缺陷（2026-09-18 实测，未在本次「夹具自包含」范围内）：ypbin-system 的
          spring-boot-maven-plugin:repackage 未配 classifier，其主构件是 BOOT-INF/classes 布局的 fat jar，
          于是**带 package 阶段的全反应堆构建**（`mvn -B clean verify`）里本模块的测试类路径看不到
          cn.ypbin.admin 的真实类：实测 CodingRulesTest.serviceImplShouldNotDependOnProviderPackages 报
          "failed to check any classes"（48 个真实 service/impl 类一个都没扫到）。所幸这是**显式失败**
          （ArchUnit 的 failOnEmptyShould 默认开启），不是静默假绿；`-pl ... -am test`（不带 package）
          与 `-DskipTests clean package` 均正常。彻底修法需给 repackage 加 classifier，或让 CodingRulesTest
          直接 import 各模块 target/classes——两者都需单独决策。
        -->
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-common</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-system</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-ai</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-auth</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin.admin</groupId>
            <artifactId>ypbin-gateway</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit：字节码级架构断言（版本与 starter 侧一致） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 5 + AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
